{
  "manifest_version": 3,
  "name": "Bloqer",
  "version": "1.0.0",
  "description": "Block distracting websites using your own editable blocklist.",

  "browser_specific_settings": {
    "gecko": {
      "id": "bloqer@bloqer.com",
      "strict_min_version": "128.0"
    }
  },

  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "action": {
    "default_title": "Site Blocker",
    "default_popup": "popup.html"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}